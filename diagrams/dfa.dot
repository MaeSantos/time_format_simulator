digraph DFA {
    rankdir=LR;
    node [shape=circle, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=11];

    // Start indicator
    start [shape=point, width=0.12];
    start -> S0;

    // Accepting states
    S10 [shape=doublecircle];
    S11 [shape=doublecircle];
    S15 [shape=doublecircle];

    // Dead state
    dead [shape=circle, label="∅"];
    dead -> dead [label="all 15 symbols"];

    // Note: all transitions not drawn lead to dead
    note [shape=box, style=dashed, label="All undefined transitions go to ∅"];
    note -> dead [style=dashed, arrowhead=none];

    // Hour digits
    S0 -> S1 [label="0"];
    S0 -> S2 [label="1"];
    S0 -> S3 [label="2"];
    S1 -> S4 [label="0"];
    S1 -> S5 [label="1-9"];
    S2 -> S5 [label="0-2"];
    S2 -> S4 [label="3-9"];
    S3 -> S4 [label="0-3"];

    // Colon and minutes
    S4 -> S6 [label=":"];
    S5 -> S7 [label=":"];
    S6 -> S8 [label="0-5"];
    S7 -> S9 [label="0-5"];
    S8 -> S10 [label="0-9"];
    S9 -> S11 [label="0-9"];

    // 12-hour suffix
    S11 -> S12 [label=""];
    S12 -> S13 [label="A"];
    S12 -> S14 [label="P"];
    S13 -> S15 [label="M"];
    S14 -> S15 [label="M"];
}